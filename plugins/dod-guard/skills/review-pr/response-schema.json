{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["reviewer", "coverage", "findings"],
  "additionalProperties": false,
  "properties": {
    "reviewer": {
      "enum": [
        "review-pr-feature",
        "review-pr-design",
        "review-pr-reliability",
        "review-pr-hygiene"
      ]
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["requirement", "status", "evidence"],
        "additionalProperties": false,
        "properties": {
          "requirement": { "type": "string", "minLength": 1 },
          "status": { "enum": ["VERIFIED", "FINDING"] },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": { "type": "object" }
    }
  }
}
