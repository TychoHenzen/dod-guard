{
  "name": "mcp-servers",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for MCP server plugins and the fossil CLI workspace",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "node -e \"const fs=require('fs');for(const p of fs.readdirSync('packages'))fs.rmSync('packages/'+p+'/dist',{recursive:true,force:true})\"",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:openspec-dashboard": "node --test tools/openspec-dashboard/test/all.test.mjs",
    "bundle": "npm run bundle --workspaces"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.0",
    "@stryker-mutator/tap-runner": "^9.6.0"
  }
}
