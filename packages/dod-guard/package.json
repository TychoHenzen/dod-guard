{
  "name": "dod-guard",
  "version": "4.10.3",
  "description": "OpenSpec scenario-coverage verification. Claude Code plugin with MCP cover, complete, and lock tools, and 28 skills.",
  "type": "module",
  "main": "dist/bundle.js",
  "bin": {
    "dod-guard": "dist/bundle.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --experimental-test-module-mocks --test \"dist/**/*.test.js\" && node --test \"skills/*/scripts/*.test.mjs\" && node --test \"skills/*/scripts/lib/*.test.mjs\"",
    "bundle": "node esbuild.config.mjs",
    "start": "node dist/bundle.js",
    "coverage": "c8 --include=\"src/*.ts\" --exclude=\"src/*.test.ts\" --reporter=text --reporter=html node --experimental-test-module-mocks --test \"dist/*.test.js\"",
    "dev": "tsc --watch"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "mcp",
    "definition-of-done",
    "verification",
    "anti-cheat"
  ],
  "author": "tychohenzen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TychoHenzen/dod-guard.git",
    "directory": "packages/dod-guard"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "c8": "^11.0.0",
    "esbuild": "^0.28.0",
    "nyc": "^18.0.0",
    "typescript": "^5.7.0"
  }
}
