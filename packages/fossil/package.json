{
  "name": "@dod-guard/fossil",
  "version": "0.1.0",
  "description": "CLI for grading commit history and git hygiene.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "fossil": "dist/bundle.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test \"dist/**/*.test.js\"",
    "bundle": "node esbuild.config.mjs",
    "start": "node dist/bundle.js",
    "coverage": "c8 --include=\"src/*.ts\" --exclude=\"src/*.test.ts\" --reporter=text --reporter=html node --test \"dist/*.test.js\"",
    "dev": "tsc --watch"
  },
  "keywords": [
    "cli",
    "git",
    "fossil"
  ],
  "author": "tychohenzen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TychoHenzen/dod-guard.git",
    "directory": "packages/fossil"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "c8": "^11.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.7.0"
  }
}
