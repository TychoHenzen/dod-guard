{
  "name": "code-explorer",
  "version": "0.1.0",
  "description": "Read-only MCP source navigation for one project.",
  "type": "module",
  "main": "dist/bundle.js",
  "bin": {
    "code-explorer": "dist/bundle.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && npm run bundle && node --test \"dist/**/*.test.js\"",
    "bundle": "node esbuild.config.mjs",
    "start": "node dist/bundle.js",
    "coverage": "c8 --include=\"dist/**/*.js\" --exclude=\"dist/**/*.test.js\" --reporter=text --reporter=html node --test \"dist/**/*.test.js\"",
    "dev": "tsc --watch"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "mcp",
    "code-navigation"
  ],
  "author": "tychohenzen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TychoHenzen/dod-guard.git",
    "directory": "packages/code-explorer"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chokidar": "4.0.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "c8": "^11.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.7.0"
  }
}
