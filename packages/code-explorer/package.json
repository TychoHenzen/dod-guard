{
  "name": "code-explorer",
  "version": "0.1.2",
  "description": "Read-only MCP source navigation for one project.",
  "type": "module",
  "main": "dist/bundle.js",
  "bin": {
    "code-explorer": "dist/bundle.js"
  },
  "scripts": {
    "build": "tsc",
    "build:test": "tsc -p tsconfig.test.json",
    "prepare:test": "node scripts/prepare-test-project.mjs",
    "test": "tsc && npm run build:test && npm run bundle && npm run prepare:test && node --test \"dist-test/tests/**/*.test.js\"",
    "bundle": "node scripts/build-browser.mjs && node esbuild.config.mjs",
    "start": "node dist/bundle.js",
    "coverage": "c8 --include=\"dist-test/src/**/*.js\" --exclude=\"dist-test/**/*.test.js\" --reporter=text --reporter=html node --test \"dist-test/tests/**/*.test.js\"",
    "practice:browser": "npm run build && npm run bundle && node scripts/practice-browser.mjs",
    "dev": "tsc --watch"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "mcp",
    "code-navigation"
  ],
  "author": "tychohenzen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TychoHenzen/dod-guard.git",
    "directory": "packages/code-explorer"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chokidar": "4.0.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^22.0.0",
    "c8": "^11.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.7.0"
  }
}
