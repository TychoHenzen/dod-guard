{
  "name": "knowledge-base",
  "version": "0.1.0",
  "description": "Persistent Markdown-backed progressive knowledge retrieval for agents.",
  "type": "module",
  "main": "dist/bundle.js",
  "bin": {
    "knowledge-base": "dist/bundle.js"
  },
  "scripts": {
    "build": "tsc",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "tsc && npm run build:test && npm run bundle && node --test \"dist-test/tests/**/*.test.js\"",
    "bundle": "node esbuild.config.mjs",
    "start": "node dist/bundle.js",
    "coverage": "c8 --include=\"dist-test/src/**/*.js\" --exclude=\"dist-test/**/*.test.js\" --reporter=text --reporter=html node --test \"dist-test/tests/**/*.test.js\"",
    "dev": "tsc --watch"
  },
  "keywords": [
    "mcp",
    "knowledge-base",
    "markdown",
    "progressive-retrieval"
  ],
  "author": "tychohenzen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TychoHenzen/dod-guard.git",
    "directory": "packages/knowledge-base"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "yaml": "^2.9.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "c8": "^11.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.7.0"
  }
}
