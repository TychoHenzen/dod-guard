{
  "name": "quality-guard",
  "version": "0.5.0",
  "description": "Structural code quality gate. Claude Code plugin with an MCP server and a PostToolUse hook that ratchets every write against a recorded baseline. Ships 1 skill: /quality-refactor.",
  "type": "module",
  "main": "dist/bundle.js",
  "bin": {
    "quality-guard": "dist/bundle.js"
  },
  "files": [
    "dist/bundle.js",
    "skills/",
    "scripts/",
    ".claude-plugin/",
    ".mcp.json"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test \"dist/*.test.js\" && node --test \"scripts/*.test.mjs\" && node --test \"skills/*/scripts/lib/*.test.mjs\"",
    "bundle": "node esbuild.config.mjs",
    "prepublishOnly": "npm run build && npm run bundle",
    "start": "node dist/bundle.js",
    "coverage": "c8 --include=\"src/*.ts\" --exclude=\"src/*.test.ts\" --reporter=text --reporter=html node --test \"dist/*.test.js\"",
    "dev": "tsc --watch"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "mcp",
    "code-quality",
    "refactoring",
    "static-analysis"
  ],
  "author": "tychohenzen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TychoHenzen/dod-guard.git",
    "directory": "packages/quality-guard"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "c8": "^11.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.7.0"
  }
}
